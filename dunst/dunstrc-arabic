# ── Dunst — Arabic theme (matching waybar/wofi) ──
# Gold & dark, ornamental, geometric borders
# palette mirrors waybar/colors.css:
#   bg #0E0D0D  fg #d6c8ab  muted #958c77
#   accent1 #6F5F40  accent2 #8B764E  accent3 #B49963

[global]
    # ── Geometry & Position ──
    width = (280, 400)
    height = (0, 140)
    origin = top-right
    offset = (12, 50)
    notification_limit = 4
    indicate_hidden = yes

    # ── Appearance — sharp geometric slab with a thin gold frame ──
    font = JetBrainsMono Nerd Font Bold 11
    markup = full
    format = "<span foreground='#B49963'><b>%s</b></span>\n<span foreground='#d6c8ab'>%b</span>"
    alignment = left
    vertical_alignment = center
    frame_width = 1
    corner_radius = 3
    separator_height = 1
    separator_color = "#8B764E66"
    padding = 12
    horizontal_padding = 18
    text_icon_padding = 14
    gap_size = 6
    line_height = 2

    # ── Behaviour ──
    sort = yes
    idle_threshold = 120
    show_age_threshold = 30
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no

    # ── Icons ──
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 2

    # ── Progress bar — gold rule, bright centre ──
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 1

    # ── Mouse actions ──
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # ── Wayland ──
    layer = overlay
    force_xwayland = false

# ── Low urgency — dim parchment on obsidian, faint bronze frame ──
[urgency_low]
    background = "#0E0D0DE6"
    foreground = "#958c77"
    frame_color = "#6F5F4080"
    highlight = "#6F5F40, #8B764E"
    format = "<span foreground='#9A8456'><b>%s</b></span>\n<span foreground='#958c77'>%b</span>"
    timeout = 5

# ── Normal urgency — gold trim like waybar modules ──
[urgency_normal]
    background = "#0E0D0DF2"
    foreground = "#d6c8ab"
    frame_color = "#8B764EB3"
    highlight = "#8B764E, #B49963, #8B764E"
    timeout = 8

# ── Critical urgency — red like battery critical ──
[urgency_critical]
    background = "#0E0D0DFA"
    foreground = "#d6c8ab"
    frame_color = "#ff5555"
    highlight = "#ff5555, #ff8080"
    format = "<span foreground='#ff5555'><b>%s</b></span>\n<span foreground='#d6c8ab'>%b</span>"
    timeout = 0
